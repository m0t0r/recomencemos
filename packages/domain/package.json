{
  "name": "@repo/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#admin/*": "./src/admin/*.ts",
    "#auth-schema": "./src/auth-schema.ts",
    "#auth/*": "./src/auth/*.ts",
    "#column-types": "./src/column-types.ts",
