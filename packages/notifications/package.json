{
  "name": "@repo/notifications",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#config": "./src/config.ts",
    "#palette": "./src/palette.ts",
    "#send": "./src/send.ts",
    "#server-only": "./src/server-only.ts",
    "#templates/*": "./src/templates/*.tsx",
    "#transport/*": "./src/transport/*.ts",
    "#user-messages": "./src/user-messages.ts"
  },
  "exports": {
    "./send": {
      "browser": "./src/browser-refusal.ts",
      "default": "./src/send.ts"
    },
    "./templates/*": {
      "browser": "./src/browser-refusal.ts",
      "default": "./src/templates/*.tsx"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "email": "email dev --dir src/templates",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/errors": "workspace:*",
    "react": "^19.3.0",
    "react-email": "^6.9.5",
    "resend": "^6.28.0"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.5",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.13.4",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
