{
  "name": "@repo/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#client": "./src/client.ts",
    "#config": "./src/config.ts",
    "#key-shapes": "./src/key-shapes.ts",
    "#keys": "./src/keys.ts",
    "#limits": "./src/limits.ts",
    "#photo-url": "./src/photo-url.ts",
    "#photos": "./src/photos.ts",
    "#reencode": "./src/reencode.ts",
    "#server-only": "./src/server-only.ts",
    "#user-messages": "./src/user-messages.ts"
  },
  "exports": {
