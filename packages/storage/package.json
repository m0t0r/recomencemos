  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
