# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# The one opt-in. `.env.example` is the template a clone copies to `.env.local`
# (`pnpm db:up` starts what it points at), so it has to be in git -- and it
# carries development-tier values only, for the reason written at the top of it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
