{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/plan-to-design-gate.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the Plan gate"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/design-to-build-gate.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the Design gate"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/build-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking protected paths and credentials"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/build-to-deploy-gate.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the Build gate"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/worktree-gate.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the worktree"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format-on-write.sh\"",
            "timeout": 15,
            "statusMessage": "Formatting"
          },
          {
            "type": "command",
            "command": "[ ! -f \".claude/skills/impeccable/scripts/hook.mjs\" ] || node \".claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".claude/skills/impeccable/scripts/hook.mjs\" ] || node \".claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/verify-before-stop.sh\"",
            "timeout": 180,
            "statusMessage": "Verifying the change"
          }
        ]
      }
    ]
  }
}
