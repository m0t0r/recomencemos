# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Claude Code worktrees
.claude/worktrees/

# scripts/go-live.sh writes both of these. Neither is repo content:
# `.go-live-facts` is one operator's app and bucket names, and
# `.go-live-evidence.md` is the transcript of one run, which belongs in a
# comment on the runbook ticket rather than in the history. Note that neither
# name matches `.env*`, which turbo.json declares a `build` input -- that is
# deliberate, and §1 of the go-live runbook is why.
.go-live-facts
.go-live-evidence.md

# ui-proof: captured before/after video, stills and snapshot baselines. An
# artifact is published to the object store and linked from the PR body; it is
# never committed. A recording is also the one file in this repo that can carry
# a face, a phone number or a live token, and the artifact store expires those
# while git would not.
.artifacts/

# Impeccable: machine-local config and generated review artifacts.
# .impeccable/config.json and .impeccable/briefs/ are committed.
.impeccable/config.local.json
.impeccable/review/
.impeccable/mocks/

# Vitest 5 centralises reports, attachments and blob output here. Nothing in
# this repo configures a reporter that writes one today; the entry is a floor,
# so a `vitest doctor` or `--reporter=json` run cannot leave artifacts staged.
.vitest
