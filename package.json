{
  "name": "recomencemos",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "test": "turbo run test test:gates spec-identifiers migrations:check",
    "test:coverage": "turbo run test:coverage && node scripts/coverage-merge.mjs",
    "test:gates": "bash .claude/hooks/gate-test.sh \"$PWD/.claude/hooks\"",
    "spec-identifiers": "node scripts/spec-identifiers.mjs",
    "page-weight": "node scripts/first-load-bytes.mjs",
    "lint": "oxlint . --max-warnings 0",
    "audit:direct": "node scripts/audit-direct.mjs",
    "audit:report": "node scripts/audit-report.mjs",
    "db:up": "docker compose up --detach --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && pnpm db:up",
    "db:migrate": "node --env-file-if-exists=apps/web/.env.local packages/domain/src/migrate/cli.ts",
    "db:generate": "pnpm --filter @repo/domain generate",
    "dev:origin": "node scripts/dev-origin.mjs",
    "admin:enrol": "PORTLESS_URL=${PORTLESS_URL:-$(node scripts/dev-origin.mjs)} node --env-file-if-exists=apps/web/.env.local packages/domain/src/admin/enrol-cli.ts",
    "migrations:check": "node scripts/migration-integrity.mjs",
    "ui-proof": "node --env-file-if-exists=apps/web/.env.local scripts/ui-proof.mjs",
    "ui-proof:setup": "bash scripts/ui-proof-setup.sh",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.22.0"
}
