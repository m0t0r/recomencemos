# Read by ../measure.sh. Development-tier and loopback-bound, like every value here.
STORE_ENDPOINT=http://127.0.0.1:19000
# Garage's web endpoint, a second listener that picks the bucket from the Host
# header. Node resolves `*.localhost` to ::1, which compose.yaml also binds.
STORE_PUBLIC_BASE=http://recomencemos-photos.web.localhost:19002
# Garage key ids are `GK` + 24 hex and secrets 64 hex; this pair is the hex of
# "recomencemos" and "recomencemos-local-dev-only-key!", imported by init.sh.
STORE_ACCESS_KEY_ID=GK7265636f6d656e63656d6f73
STORE_SECRET_ACCESS_KEY=7265636f6d656e63656d6f732d6c6f63616c2d6465762d6f6e6c792d6b657921
STORE_PUBLIC_LIST=http://recomencemos-photos.web.localhost:19002/?list-type=2
